rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidProfession(value) {
      return value in ['machinist', 'storekeeper', 'deliveryDriver', 'chauffeur', 'securityAgent', 'other'];
    }

    function isValidSelfUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(userId)
        && changed.hasOnly(['name', 'profession', 'reminders', 'homeLatitude', 'homeLongitude', 'fcmToken'])
        && (!changed.hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120))
        && (!changed.hasAny(['profession']) || isValidProfession(request.resource.data.profession))
        && (!changed.hasAny(['reminders']) || (
          request.resource.data.reminders is map
          && request.resource.data.reminders.keys().hasOnly(['enabled', 'time'])
          && request.resource.data.reminders.enabled is bool
          && request.resource.data.reminders.time is string
        ))
        && (!changed.hasAny(['homeLatitude']) || request.resource.data.homeLatitude is number)
        && (!changed.hasAny(['homeLongitude']) || request.resource.data.homeLongitude is number)
        && (!changed.hasAny(['fcmToken']) || request.resource.data.fcmToken is string);
    }

    // --- User Data ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'role', 'profession', 'monthlyBaseSalary', 'currency', 'createdAt'])
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && isValidProfession(request.resource.data.profession)
        && request.resource.data.monthlyBaseSalary == 0
        && request.resource.data.currency == 'FCFA'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || isValidSelfUpdate(userId);
      
      // --- Subcollections ---
      match /timeEntries/{timeEntryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /attendanceOverrides/{overrideId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /notifications/{notificationId} {
        // CORRECTION : Ajout de 'list' pour permettre l'affichage de la liste des notifs
        allow read, write, list: if isOwner(userId);
      }
      
      match /leaveRequests/{leaveRequestId} {
          // Employees can create and view their own requests; only admins can change them.
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId)
            && request.resource.data.userId == userId;
          allow update, delete: if isAdmin();
      }
      
      match /workplaceUpdateLogs/{logId} {
          allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Minimal employee directory data; sensitive fields stay in /users.
    match /publicProfiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'profession'])
        && request.resource.data.id == profileId
        && request.resource.data.name is string
        && request.resource.data.profession is string;
      allow delete: if isAdmin();
    }

    // --- Teams ---
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Global Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /leaveAnnouncements/{announcementId} {
        allow read: if isSignedIn();
        allow create: if isAdmin(); 
    }

    match /absenceJustifications/{justificationId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read: if (resource.data.userId == request.auth.uid) || isAdmin();
        allow update: if isAdmin();
        allow delete: if (resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}